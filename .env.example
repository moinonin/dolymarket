# Database URL (defaults to sqlite+aiosqlite:///./dolymarket.db if unset).
# Supports Turso libSQL (libsql://<host> + DATABASE_TOKEN) or Postgres (postgresql+asyncpg://...).
DATABASE_URL=sqlite+aiosqlite:///./dolymarket.db
DATABASE_TOKEN=

# JWT Secret
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start when this is unset or a known default; set
# ALLOW_INSECURE_SECRETS=1 only for local test runs.
# Note: HS256 and 24h (1440m) TTL are used in app/core/security.py.
JWT_SECRET=

# Reverse proxy / CORS / WebSocket hardening (production deployments)
# Trust X-Forwarded-For for rate-limit bucketing (only behind a trusted proxy).
TRUST_PROXY_HEADERS=
# Comma-separated exact frontend origins; defaults to "*" for local dev.
CORS_ALLOW_ORIGINS=*
# Extra origins allowed to open platform WebSockets (same-host is always ok).
WS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Federated sign-in (optional). A provider without credentials is reported as
# "not configured" and its button is disabled in the UI.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory (tenant) id, or "common" for multi-tenant apps
MICROSOFT_TENANT=common

APPLE_CLIENT_ID=
# Either a static client secret ...
APPLE_CLIENT_SECRET=
# ... or a Sign in with Apple key (ES256 client assertion)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Where the browser is sent after a federated sign-in. Relative ("/") keeps the
# callback on this origin; use an absolute URL when the SPA is served from a
# different host during development.
OAUTH_FRONTEND_CALLBACK=/
# Public base URL of this API when it differs from the incoming request host
OAUTH_REDIRECT_BASE=

# ---------------------------------------------------------------------------
# WebAuthn / passkeys
# ---------------------------------------------------------------------------
# Relying party id: the domain serving the frontend (no scheme, no port)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Dolymarket
# Origin(s) the ceremony may be performed from (comma separated for several)
WEBAUTHN_ORIGIN=http://localhost:8000
WEBAUTHN_ORIGINS=http://localhost:8000,http://localhost:5173

# Optional Provider Keys
GEMINI_API_KEY=
GITHERI_API_KEY=

# Pro Desks (non-custodial copy trading)
COPY_TRADING_ENABLED=true
DESK_MIN_CLOSED_POSITIONS=10
DESK_MIN_DAYS_ACTIVE=14
DESK_MIN_COPY_RATIO=0.0100
DESK_MAX_COPY_RATIO=1.0000
DESK_DEFAULT_COPY_RATIO=0.2500
DESK_DEFAULT_PER_MARKET_CAP_USDC=50.0000
DESK_MAX_PER_MARKET_EQUITY_PCT=20
DESK_MAX_TOTAL_EQUITY_PCT=25
DESK_STALENESS_BPS=200
DESK_DRAWDOWN_BREAKER_PCT=20


# ---------------------------------------------------------------------------
# DexBuilder integration (prediction market parity)
# ---------------------------------------------------------------------------
DEXBUILDER_API_BASE=https://api.dexbuilder.com
DEXBUILDER_API_KEY=
DEXBUILDER_API_SECRET=
DEXBUILDER_BROKER_ID=
# Upstream websocket broker. Server-side only: the browser talks to the
# backend bridge at /api/v4/prediction/live/ws, never to the broker directly.
DEXBUILDER_WS_URL=wss://broker.dexbuilder.com/ws/dex-builder/prediction
# Optional host override for the browser websocket (local and live streams).
# VITE_WS_URL=

# ---------------------------------------------------------------------------
# Fear & Greed Market Maker
# ---------------------------------------------------------------------------
# Default dry_run mode when starting a desk MM bot (true = paper quotes only)
MM_DRY_RUN=true
# Safety override: set to 1/true to force dry-run globally (blocks live CLOB orders)
MM_FORCE_DRY_RUN=0
